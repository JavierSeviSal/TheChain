# ─── Hugging Face Xet Storage ────────────────────────────────────────────────
# Large / binary files tracked via Git LFS with xet as the transfer backend.
# Run `git xet install` once per machine to register the xet transfer agent.
# See: https://huggingface.co/docs/hub/repositories-xet
# Card images (~15 MB total, 92 files)
static/cards/**/*.png filter=lfs diff=lfs merge=lfs -text
# Board / mat images
static/boards/**/*.png filter=lfs diff=lfs merge=lfs -text
# Catch-all for any future image assets
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.svg filter=lfs diff=lfs merge=lfs -text
# Other binary formats that may appear in the future
*.pdf filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
